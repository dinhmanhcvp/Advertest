# ==========================================
# AdverTest Environment Configuration
# ==========================================

# ------------------------------------------
# Application / Backend Config
# ------------------------------------------
APP_ENV=development
API_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
SECRET_KEY=your_super_secret_key_change_in_production

# ------------------------------------------
# External Integrations
# ------------------------------------------
# Label Studio configuration for manual annotation fallbacks
LABEL_STUDIO_URL=http://localhost:8080
LABEL_STUDIO_API_KEY=dummy_ls_api_key_123

# Cloudflare R2 / AWS S3 (For storing the adversarial image pool)
AWS_ACCESS_KEY_ID=dummy_access_key
AWS_SECRET_ACCESS_KEY=dummy_secret_key
AWS_REGION=us-east-1
S3_BUCKET_NAME=advertest-attack-pool

# Data Block Auth (For downloading base Ego4D datasets)
DATA_BLOCK_ACCESS_TOKEN=dummy_data_block_token

# ------------------------------------------
# Feature Flags
# ------------------------------------------
# If True, bypasses heavy GPU generation and serves pre-computed JSON artifacts (Great for presentations!)
ENABLE_DEMO_MODE=True

# Defines the policy used by the Reinforcement Learning agent (UCB vs Epsilon-Greedy)
RL_POLICY_MODE=epsilon-greedy
